{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velarumpay.com/velarum.webhook_endpoint.v1.schema.json",
  "title": "VelarumPay Webhook Endpoint v1",
  "type": "object",
  "required": ["webhook_endpoint_id", "merchant_id", "url", "event_types", "status", "version", "created_at", "updated_at"],
  "properties": {
    "webhook_endpoint_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "merchant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "status": {"type": "string", "enum": ["draft", "active", "paused", "deleted"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "x-velarumpay-contract-version": "velarum.control-plane.v1"
}
