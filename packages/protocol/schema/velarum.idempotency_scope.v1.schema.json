{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velarumpay.com/velarum.idempotency_scope.v1.schema.json",
  "title": "VelarumPay Idempotency Scope v1",
  "type": "object",
  "required": ["version", "merchant_id", "actor_id", "route", "key", "request_fingerprint"],
  "properties": {
    "version": { "const": "velarum.idempotency_scope.v1" },
    "merchant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "route": { "type": "string", "minLength": 1, "maxLength": 256 },
    "key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "request_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "x-velarumpay-contract-version": "velarum.platform-api.v1"
}
