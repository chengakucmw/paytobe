{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velarumpay.com/velarum.agent.v1.schema.json",
  "title": "VelarumPay Agent v1",
  "type": "object",
  "required": ["agent_id", "merchant_id", "name", "runtime", "environment", "allowed_scopes", "token_revocation_version", "status", "version", "created_at", "updated_at"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "merchant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 80},
    "environment": {"type": "string", "enum": ["sandbox", "testnet", "production"]},
    "source_domain": {"type": "string", "minLength": 1, "maxLength": 253},
    "allowed_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["payment.requests.create", "payment.requests.read", "transaction_contexts.create", "transaction_contexts.read", "wallet.addresses.read"]}},
    "token_revocation_version": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["draft", "active", "suspended", "revoked"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "x-velarumpay-contract-version": "velarum.control-plane.v1"
}
