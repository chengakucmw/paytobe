{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.Paytobe.com/Paytobe.agent_credential.v1.schema.json",
  "title": "Paytobe Agent Credential v1",
  "type": "object",
  "required": ["credential_id", "merchant_id", "agent_id", "kid", "alg", "public_key", "not_before", "expires_at", "revocation_version", "status", "version", "created_at", "updated_at"],
  "properties": {
    "credential_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "merchant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kid": {"type": "string", "minLength": 1, "maxLength": 128},
    "alg": {"const": "Ed25519"},
    "public_key": {"type": "string", "minLength": 43, "maxLength": 160},
    "proof_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": "string", "format": "date-time"},
    "revocation_version": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["pending_proof", "active", "expiring", "expired", "revoked"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "x-Paytobe-contract-version": "Paytobe.control-plane.v1"
}
