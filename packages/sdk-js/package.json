{
  "name": "@velarumpay/sdk-js",
  "version": "0.1.0",
  "description": "Minimal VelarumPay Platform API client for local agents and connectors.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "check": "node --check src/index.js && node --test test/*.test.mjs && npm run pack:dry",
    "pack:dry": "npm pack --dry-run --json >/dev/null",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@velarumpay/protocol": "0.1.0"
  }
}
