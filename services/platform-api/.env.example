PORT=8787
NODE_ENV=development
RUNTIME_ENV=development
PUBLIC_BASE_URL=http://localhost:8787
TRUST_PROXY=false

# OpenClaw signs POST /v1/payment-intents with HMAC-SHA256 over the raw JSON body.
OPENCLAW_DEVICE_SECRET=change-me-openclaw-secret
OPENCLAW_DEVICE_SECRET_PREVIOUS=
OPENCLAW_DEVICE_SECRETS=
OPENCLAW_WS_TOKEN=
ALLOW_UNSIGNED_OPENCLAW=false
ALLOW_UNSIGNED_OPENCLAW_LOCAL_ONLY=true

# Browser runtime boundary. Production must set an explicit allowlist and must not use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8787
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_CREDENTIALS=false

# In-memory runtime rate limits.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=120

# Optional default app target for connection-less / legacy delivery. If empty, a request
# without an explicit target device is rejected with target_device_required; the relay
# never auto-selects an arbitrary registered device. See src/routing.js.
DEFAULT_APP_DEVICE_ID=

# Storage. SQLite is the default; set a durable absolute path in deployed environments.
RELAY_STORE_DRIVER=sqlite
RELAY_STORE_PATH=data/relay-store.sqlite
RELAY_STORE_LEGACY_JSON=data/relay-store.json

# Observability. Metrics are public unless METRICS_TOKEN or OBSERVABILITY_TOKEN is set;
# in production one of them is REQUIRED (the server refuses to boot otherwise).
# Reading audit events always requires AUDIT_LOG_READ_TOKEN or OBSERVABILITY_TOKEN.
METRICS_TOKEN=
AUDIT_LOG_READ_TOKEN=
OBSERVABILITY_TOKEN=
AUDIT_EVENT_RETENTION=500
AUDIT_LOG_STDOUT=true

# Firebase Cloud Messaging HTTP v1. Production preflight requires FCM to be enabled.
# The service account file is mounted as a secret and must never be committed.
# Generate the encryption key with: openssl rand -base64 32
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
FCM_TOKEN_ENCRYPTION_KEY=
FCM_TIMEOUT_MS=10000

# Risk policy. Stellar public-network payments are disabled by default and fail closed.
# Enabling them requires a positive small-payment cap, an HTTPS Horizon endpoint, and
# at least one verified recipient in ADDRESS_WHITELIST_STELLAR.
STELLAR_PUBLIC_ENABLED=false
STELLAR_PUBLIC_SINGLE_PAYMENT_MAX_XLM=1
STELLAR_PUBLIC_HORIZON_URL=https://horizon.stellar.org
# Per-asset daily spend cap. NOTE: the "day" is UTC — the running total resets at
# 00:00 UTC (the ledger keys on the UTC calendar date via toISOString), NOT the
# operator's local midnight, so a cap-day straddles two local days outside UTC. The
# cap counts COMMITTED spend = confirmed + in-flight reservations (see F1 in store.js).
DAILY_LIMIT_USDC=1000
DAILY_LIMIT_XLM=1000
ADDRESS_WHITELIST_EVM=
ADDRESS_WHITELIST_STELLAR=

# Optional Velarum HMAC verification for prototype payloads.
VELARUM_SHARED_SECRET=
