PORT=8791
AGENTFOOD_RUNTIME_ENV=development
AGENTFOOD_PUBLIC_BASE_URL=http://127.0.0.1:8791
AGENTFOOD_API_KEY=
AGENTFOOD_STORE_PATH=data/agentfood-store.json

# Standard Platform API Agent identity. The Ed25519 PKCS#8 value and Webhook
# secret belong in the deployment secret manager, never in this file.
PLATFORM_API_URL=http://127.0.0.1:8787
PLATFORM_TIMEOUT_MS=10000
AGENTFOOD_MERCHANT_ID=agentfood
AGENTFOOD_AGENT_ID=agentfood-testnet
AGENTFOOD_AGENT_CLIENT_ID=agentfood-service
AGENTFOOD_AGENT_CREDENTIAL_KID=
AGENTFOOD_AGENT_CREDENTIAL_PRIVATE_KEY_PKCS8_B64=
AGENTFOOD_AGENT_ASSERTION_AUDIENCE=https://api-testnet.velarumpay.com/v1/agent-auth/token
AGENTFOOD_WEBHOOK_SECRET=
AGENTFOOD_WEBHOOK_TOLERANCE_SECONDS=300

# Real Stellar public-network requests are fail-closed and disabled by default.
# The payment amount is a fixed small demonstration settlement; it is not the mock
# catalog total and it never represents real food fulfillment.
AGENTFOOD_STELLAR_MAINNET_ENABLED=false
AGENTFOOD_STELLAR_MAINNET_MAX_XLM=1
AGENTFOOD_STELLAR_PAYMENT_AMOUNT_XLM=0.1
AGENTFOOD_STELLAR_HORIZON_URL=https://horizon.stellar.org
AGENTFOOD_RECIPIENT_ID=
AGENTFOOD_RECIPIENT_VERSION_ID=
