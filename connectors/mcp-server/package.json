{
  "name": "@velarumpay/mcp-server",
  "version": "0.1.0",
  "description": "VelarumPay MCP stdio server for Payment Request v1 tools.",
  "type": "module",
  "main": "./src/tools.js",
  "types": "./src/tools.d.ts",
  "exports": {
    ".": {
      "types": "./src/tools.d.ts",
      "import": "./src/tools.js"
    },
    "./server": "./src/index.js"
  },
  "bin": {
    "velarumpay-mcp-server": "./src/index.js"
  },
  "files": [
    "src",
    "fixtures",
    "README.md",
    "package.json"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/mcp.js && node --check src/tools.js && node --test test/*.test.mjs && npm run pack:dry",
    "pack:dry": "npm pack --dry-run --json >/dev/null",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@velarumpay/sdk-js": "0.1.0"
  }
}
