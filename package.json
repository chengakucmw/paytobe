{
  "name": "Paytobe-code",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "devDependencies": {
    "express": "^4.19.2"
  },
  "workspaces": [
    "packages/protocol",
    "packages/sdk-js",
    "services/platform-api",
    "connectors/openclaw-telegram",
    "connectors/mcp-server",
    "connectors/hermes"
  ],
  "scripts": {
    "check": "npm run check:protocol && npm run check:sdk-js && npm run check:platform-api && npm run check:agentfood && npm run check:edge && npm run check:website && npm run check:merchant-portal && npm run check:openclaw-telegram && npm run check:mcp-server && npm run check:hermes",
    "check:protocol": "npm --prefix packages/protocol run check",
    "check:sdk-js": "npm --prefix packages/sdk-js run check",
    "check:platform-api": "npm --prefix services/platform-api run check",
    "check:agentfood": "npm --prefix services/agentfood run check",
    "check:edge": "npm --prefix services/platform-api/edge-testnet run check",
    "check:website": "npm --prefix apps/website run check",
    "check:merchant-portal": "npm --prefix apps/merchant-portal run check",
    "check:openclaw-telegram": "npm --prefix connectors/openclaw-telegram run check",
    "check:mcp-server": "npm --prefix connectors/mcp-server run check",
    "check:hermes": "npm --prefix connectors/hermes run check",
    "test": "npm --prefix services/platform-api test && npm run test:agentfood && npm run test:edge && npm run test:website && npm run test:docs && npm run test:merchant-portal && npm run test:sdk-js && npm run test:mcp-server && npm run test:hermes",
    "test:agentfood": "npm --prefix services/agentfood test",
    "test:edge": "npm --prefix services/platform-api/edge-testnet test",
    "test:website": "npm --prefix apps/website test",
    "test:docs": "npm --prefix apps/docs test",
    "test:merchant-portal": "npm --prefix apps/merchant-portal test",
    "test:sdk-js": "npm --prefix packages/sdk-js test",
    "test:mcp-server": "npm --prefix connectors/mcp-server test",
    "test:hermes": "npm --prefix connectors/hermes test",
    "smoke:quickstart": "node examples/payment-request-quickstart/smoke-check.mjs",
    "smoke:cross-component": "node scripts/cross-component-smoke.mjs",
    "package:integrations": "npm --prefix packages/protocol run pack:dry && npm --prefix packages/sdk-js run pack:dry && npm --prefix connectors/mcp-server run pack:dry && npm --prefix connectors/hermes run pack:dry",
    "android:build": "cd apps/android && ./gradlew testDebugUnitTest assembleDebug",
    "ios:build": "xcodebuild -project apps/ios/Paytobe.xcodeproj -scheme Paytobe -configuration Debug -sdk iphonesimulator build",
    "wallet-core:test": "cd crates/Paytobe-wallet-core && cargo test",
    "license:check": "node scripts/check-license-policy.mjs",
    "sbom:release": "node scripts/generate-release-sbom.mjs",
    "contract:hd": "node --test tests/protocol/hd-derivation-contract.test.mjs",
    "test:all": "bash scripts/test-all.sh",
    "release:gate": "node scripts/release-gate.mjs"
  }
}
