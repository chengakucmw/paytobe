# ============================================================================
# VelarumPay —— 正式签名配置模板（可选；仅当你要「固定签名」分发/上架时才需要）
# ----------------------------------------------------------------------------
# 平时完全不用管这个文件：release 默认用 debug 签名，打出的 APK 已经能直接装真机。
#
# 当你想用一把「固定的正式签名」时（例如发给测试者、或上架应用商店）：
#   1) 生成你自己的 keystore（密码自己设，且务必备份好——丢了就没法更新已发布的 App）：
#        cd apps/android
#        keytool -genkeypair -v \
#          -keystore app/velarumpay-release.jks \
#          -alias velarumpay -keyalg RSA -keysize 2048 -validity 10000
#   2) 把本文件复制为同目录下的 keystore.properties（去掉 .example 后缀），填好下面四项。
#   3) 重新构建 release —— build.gradle 会自动发现并改用你的正式签名，无需改代码。
#
# 安全：keystore.properties 与 *.jks 已被 .gitignore 忽略，不会进 git（密钥务必保密）。
# ============================================================================

# .jks 文件路径（相对 apps/android/app/ 目录；也可写绝对路径）
storeFile=velarumpay-release.jks
# keystore 密码
storePassword=在这里填你的密码
# 密钥别名（与上面 keytool 的 -alias 一致）
keyAlias=velarumpay
# 密钥密码（keytool 默认与 keystore 密码相同）
keyPassword=在这里填你的密码
