# ============================================================================
# Paytobe release signing configuration template.
# ----------------------------------------------------------------------------
# Release artifacts never fall back to the Android debug key. To use an ignored
# local properties file instead of the Paytobe_ANDROID_* environment values:
#   1) Generate a persistent keystore and back it up in an access-controlled store:
#        cd apps/android
#        keytool -genkeypair -v \
#          -keystore app/Paytobe-release.jks \
#          -alias Paytobe -keyalg RSA -keysize 2048 -validity 10000
#   2) Copy this file to apps/android/keystore.properties and fill in all values.
#   3) Build the release artifact. Gradle rejects incomplete signing configuration.
#
# Security: keystore.properties and *.jks are ignored by Git. Never commit them.
# ============================================================================

# Path relative to apps/android/app, or an absolute path.
storeFile=Paytobe-release.jks
# Keystore password.
storePassword=在这里填你的密码
# Key alias.
keyAlias=Paytobe
# Key password.
keyPassword=在这里填你的密码
